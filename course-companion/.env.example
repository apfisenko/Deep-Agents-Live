# Course Companion — переменные окружения
# Скопируйте этот файл в .env и заполните значения.

# OpenRouter API key — получить на https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Уровень логирования: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Директория для сохранения отчётов проверки ДЗ (default: ./reviews)
REVIEWS_DIR=./reviews

# --- Шов companion ↔ checker (Sprint 15) ---
# agent_protocol (default) — AsyncSubAgent + CHECKER_URL (Sprint 12)
# a2a — A2A-клиент чужого checker
# CHECKER_MODE=agent_protocol
# CHECKER_MODE=a2a
# A2A_CHECKER_URL=http://localhost:2025
# A2A_ALLOW_FOLLOWUP=false
# A2A_CHECKER_GRAPH_ID=checker
