# Course Companion — переменные окружения
# Скопируйте этот файл в .env и заполните значения.

# OpenRouter API key — получить на https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Уровень логирования: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Директория для сохранения отчётов проверки ДЗ (default: ./reviews)
REVIEWS_DIR=./reviews
