# OpenRouter (required)
OPENROUTER_API_KEY=

# API base URL (optional — default: https://openrouter.ai/api/v1)
# Alias: OPENROUTER_URL
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Model override (optional — fallback: config/agent.yaml)
# Short form auto-prefixed: openai/gpt-4o-mini → openrouter:openai/gpt-4o-mini
OPENROUTER_MODEL=
# OPENROUTER_TEMPERATURE=0.2
# OPENROUTER_MAX_TOKENS=2048

# Review mode: single | subagents (optional — CLI -Mode overrides; default: subagents)
# REVIEW_MODE=subagents

# Logging
LOG_LEVEL=INFO
